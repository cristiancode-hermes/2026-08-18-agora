{
  "name": "agora",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "build": "npm run build:api && npm run build:web",
    "start:api": "cd apps/api && npm run start:dev",
    "start:web": "cd apps/web && ng serve"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
